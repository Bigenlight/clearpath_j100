<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<!--
  package.xml — j100_teleop 패키지 메타데이터
  =============================================
  ament_python 빌드 타입 패키지의 표준 매니페스트 파일.
  colcon이 빌드 순서 계산, 의존성 해결, 패키지 인덱스 등록에 이 파일을 사용한다.
-->
<package format="3">

  <!-- 패키지 이름: 'ros2 run j100_teleop ...' 등에서 사용되는 식별자 -->
  <name>j100_teleop</name>

  <!-- 버전: major.minor.patch 형식 -->
  <version>0.1.0</version>

  <!-- 패키지 한 줄 설명 -->
  <description>J100 (Jackal) 로봇용 PyQt5 가상 조이스틱 텔레옵 UI 패키지</description>

  <!-- 유지보수자 이름 및 이메일 -->
  <maintainer email="tpingouin@gmail.com">Theo</maintainer>

  <!-- 라이선스: j100_nav2_bringup과 동일한 Apache-2.0 -->
  <license>Apache-2.0</license>

  <!--
    buildtool_depend: 빌드 도구 자체에 대한 의존성.
    ament_python: Python 패키지를 ament 빌드 시스템으로 빌드하기 위한 도구.
    colcon이 이 패키지를 ament_python 방식으로 처리하도록 지시한다.
  -->
  <buildtool_depend>ament_python</buildtool_depend>

  <!--
    exec_depend: 런타임 실행 시 필요한 의존성.
    빌드할 때는 필요 없고, 설치 후 노드를 실행할 때 반드시 있어야 하는 패키지들.
  -->

  <!-- rclpy: ROS2 Python 클라이언트 라이브러리. 노드 생성, 퍼블리셔, 타이머 등 ROS2 코어 기능 제공 -->
  <exec_depend>rclpy</exec_depend>

  <!-- geometry_msgs: geometry_msgs/Twist 메시지 타입 제공. /j100_0001/cmd_vel 토픽 발행에 사용 -->
  <exec_depend>geometry_msgs</exec_depend>

  <!-- python3-pyqt5: PyQt5 GUI 프레임워크. 가상 조이스틱 UI 위젯을 그리는 데 필요 -->
  <exec_depend>python3-pyqt5</exec_depend>

  <!-- ros2launch: 'ros2 launch' 명령 제공. teleop_split.launch.py 로 두 노드를
       한 번에 실행하는 데 필요. (launch/launch_ros 파이썬 패키지를 끌어옴) -->
  <exec_depend>ros2launch</exec_depend>

  <!--
    test_depend: 테스트 실행 시에만 필요한 의존성.
    'colcon test' 또는 'ament_python_test'로 테스트할 때만 사용됨.
  -->

  <!-- ament_copyright: 소스 파일의 저작권 헤더 형식을 검사하는 linting 도구 -->
  <test_depend>ament_copyright</test_depend>

  <!-- ament_flake8: PEP 8 스타일 + 추가 Python 코드 품질 검사 (flake8 래퍼) -->
  <test_depend>ament_flake8</test_depend>

  <!-- ament_pep257: docstring 스타일(PEP 257) 검사 도구 -->
  <test_depend>ament_pep257</test_depend>

  <!-- python3-pytest: Python 단위 테스트 프레임워크. test/ 디렉터리의 테스트 파일 실행 -->
  <test_depend>python3-pytest</test_depend>

  <!--
    export > build_type: colcon에게 이 패키지의 빌드 방식을 알린다.
    'ament_python'이면 setup.py 기반 Python 패키지로 처리한다.
    (C++ 패키지라면 'ament_cmake'를 쓴다)
  -->
  <export>
    <build_type>ament_python</build_type>
  </export>

</package>
