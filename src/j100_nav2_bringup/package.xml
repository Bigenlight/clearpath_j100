<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>j100_nav2_bringup</name>
  <version>0.0.1</version>
  <description>One-command bringup for the Clearpath J100 Nav2 stack (simulation + viz + localization + nav2 + auto-set-initial-pose + Qt nav-goal UI).</description>
  <maintainer email="tpingouin@gmail.com">Theo</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>python3-pyqt5</exec_depend>
  <exec_depend>clearpath_gz</exec_depend>
  <exec_depend>clearpath_viz</exec_depend>
  <exec_depend>clearpath_nav2_demos</exec_depend>
  <exec_depend>ros2cli</exec_depend>
  <exec_depend>ros2topic</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
